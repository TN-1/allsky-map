# CARTO API Key for basemap tiles
CARTO_API_KEY=

# Local Timezone (e.g., UTC, Australia/Adelaide, America/New_York)
TZ=UTC

# Domain name for Traefik routing and SSL certificates
DOMAIN_NAME=allsky-map.com

# Let's Encrypt notification email
ACME_EMAIL=admin@allsky-map.com

# Shared secrets for the bulk image export endpoint (/api/bulk/images.zip).
# Comma-separated list of keys, optionally with labels or emails for access tracking (e.g. key1:researcher@uni.edu,key2:lab@observatory.org or key1,key2).
# Generate random keys with: openssl rand -hex 32
# Provide values to authorised bulk consumers via a secure channel.
# Leave empty to disable the bulk export endpoint entirely.
BULK_API_KEYS=
